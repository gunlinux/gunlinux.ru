{
  "name": "gunlinux.ru",
  "version": "1.0.0",
  "description": "CSS bundling for gunlinux.ru",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf app/static/dist && esbuild app/static/src/styles.css --bundle --minify --outfile=app/static/dist/css/bundle.css",
    "watch": "esbuild app/static/src/styles.css --bundle --minify --outfile=app/static/dist/css/bundle.css --watch"
  },
  "keywords": [
    "css",
    "bundling"
  ],
  "author": "gunlinux",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
