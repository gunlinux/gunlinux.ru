# gunlinux.ru — Rust (axum) service, Docker image deployment.
#
# Runs the public Docker Hub image gunlinux/gunlinux.ru. The @IMAGE_TAG@
# placeholder is substituted with the deploying commit's short SHA by
# .github/deploy.sh at install time (sed), so the unit always pins the exact
# deployed revision — rollback is a restart with a previous tag.
#
# --network host: the app binds 127.0.0.1:5000 (BIND_ADDR), exactly where the
# nginx vhost proxy_passes (no proxy change), and reaches the local Postgres
# container `db` at 127.0.0.1:5433 — the same topology the legacy Python unit
# used. The legacy unit file "gunlinux.ru" stays installed for rollback.
#
# Env: .env (DATABASE_URL, SECRET_KEY, ...) is fed to the container via
# docker --env-file; the Rust settings loader reads it from the process
# environment (extra keys like SQLALCHEMY_DATABASE_URI are ignored).

[Unit]
Description=Gunlinux.ru Rust (axum) app — docker image
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=loki
Group=loki

# `-` prefix: tolerated failure (container not running yet on first start).
ExecStartPre=-/usr/bin/docker rm -f gunlinux-ru
ExecStartPre=/usr/bin/docker pull gunlinux/gunlinux.ru:@IMAGE_TAG@
ExecStart=/usr/bin/docker run --rm --name gunlinux-ru \
  --network host \
  --env-file /home/loki/www/gunlinux.ru/.env \
  -e BIND_ADDR=127.0.0.1:5000 \
  gunlinux/gunlinux.ru:@IMAGE_TAG@
ExecStop=/usr/bin/docker stop gunlinux-ru
Restart=on-failure
RestartSec=3
SyslogIdentifier=gunlinux-ru

[Install]
WantedBy=multi-user.target
