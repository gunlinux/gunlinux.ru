# gunlinux.ru — Rust (axum) service.
#
# Cutover replacement for the legacy Python/gunicorn unit "gunlinux.ru".
# The name is deliberately DISTINCT ("gunlinux-ru") so both units can coexist
# in /etc/systemd/system: the legacy unit file is left installed for rollback
# (see deploy/CUTOVER.md) and this unit takes over port 5000.
#
# Modeled on the legacy unit's conventions (User=loki, WorkingDirectory, port
# 5000 behind nginx) plus hardening. Installed by .github/deploy.sh to
# /etc/systemd/system/gunlinux-ru.service.

[Unit]
Description=Gunlinux.ru Rust (axum) app
After=network.target

[Service]
User=loki
Group=loki
WorkingDirectory=/home/loki/www/gunlinux.ru

# Server-side env file (DATABASE_URL, SECRET_KEY, YANDEX_*). Values stay on
# the host — never in git. The binary also loads .env from WorkingDirectory
# via dotenvy, so this is belt-and-braces.
EnvironmentFile=/home/loki/www/gunlinux.ru/.env

# Bind where nginx expects the blog app (vhost gunlinux.ru: proxy_pass
# http://127.0.0.1:5000). The binary defaults to 0.0.0.0:8000 — override is
# required for the cutover.
Environment="BIND_ADDR=127.0.0.1:5000"
# Webpack CSS/JS output; the app also serves /static from here (nginx serves
# the same tree from disk after the cutover nginx change).
Environment="STATIC_DIR=/home/loki/www/gunlinux.ru/app/static"
Environment="RUST_LOG=info"

ExecStart=/usr/local/bin/gunlinux-ru
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SyslogIdentifier=gunlinux-ru

# Hardening. The app is a pure network service: Postgres is remote (docker
# container `db` on 127.0.0.1:5433), static files are read-only, caches are
# in-memory. The only local write path is ./tmp (sqlite dev fallback).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/loki/www/gunlinux.ru/tmp

[Install]
WantedBy=multi-user.target
